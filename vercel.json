{
  "version": 2,
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/index.ts": {
      "includeFiles": "{lib/**,src/**,local-store.json}"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.ts"
    },
    {
      "source": "/api",
      "destination": "/api/index.ts"
    },
    {
      "source": "/ZID-BD-:storeCode",
      "destination": "/index.html"
    },
    {
      "source": "/store/:slug",
      "destination": "/index.html"
    },
    {
      "source": "/e/:slug",
      "destination": "/index.html"
    },
    {
      "source": "/:storeSlug",
      "destination": "/index.html"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}