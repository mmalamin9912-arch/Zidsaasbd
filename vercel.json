{
  "version": 2,
  "buildCommand": "npx vite build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/health",
      "destination": "/api/index.ts"
    },
    {
      "source": "/api/merchants/:path*",
      "destination": "/api/index.ts"
    },
    {
      "source": "/api/merchants",
      "destination": "/api/index.ts"
    },
    {
      "source": "/api/orders/:path*",
      "destination": "/api/index.ts"
    },
    {
      "source": "/api/orders",
      "destination": "/api/index.ts"
    },
    {
      "source": "/api/customers/:path*",
      "destination": "/api/index.ts"
    },
    {
      "source": "/api/customers",
      "destination": "/api/index.ts"
    },
    {
      "source": "/api/admin/:path*",
      "destination": "/api/index.ts"
    },
    {
      "source": "/api/stores/slug/:slug*",
      "destination": "/api/index.ts"
    },
    {
      "source": "/api/stores/by-slug",
      "destination": "/api/index.ts"
    },
    {
      "source": "/api/stores/:path*",
      "destination": "/api/index.ts"
    },
    {
      "source": "/api/stores",
      "destination": "/api/index.ts"
    },
    {
      "source": "/api/store/:path*",
      "destination": "/api/index.ts"
    },
    {
      "source": "/api/subscription/:path*",
      "destination": "/api/index.ts"
    },
    {
      "source": "/api/subscriptions",
      "destination": "/api/index.ts"
    },
    {
      "source": "/api/subscriptions/:path*",
      "destination": "/api/index.ts"
    },
    {
      "source": "/api/security/:path*",
      "destination": "/api/index.ts"
    },
    {
      "source": "/api/security",
      "destination": "/api/index.ts"
    },
    {
      "source": "/api/export/:path*",
      "destination": "/api/index.ts"
    },
    {
      "source": "/api/export",
      "destination": "/api/index.ts"
    },
    {
      "source": "/api/auth/:path*",
      "destination": "/api/index.ts"
    },
    {
      "source": "/api/courier/:path*",
      "destination": "/api/index.ts"
    },
    {
      "source": "/api/analytics-summary",
      "destination": "/api/index.ts"
    },
    {
      "source": "/api/admin-analytics-summary",
      "destination": "/api/index.ts"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/index.ts": {
      "includeFiles": "api/server.ts"
    }
  }
}