# GEMINI_API_KEY: Optional Gemini API key for Zid AI (fallback provider).
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# OPENAI_API_KEY: Optional OpenAI API key for Zid AI (preferred provider).
# When set, Zid AI answers live via OpenAI; otherwise it falls back to Gemini,
# and finally to the built-in smart guidance engine if neither key is present.
OPENAI_API_KEY=""

# OPENAI_MODEL: Optional OpenAI chat model override (default: gpt-4o-mini).
OPENAI_MODEL="gpt-4o-mini"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Supabase Authentication Keys for Real Email OTP Delivery
VITE_SUPABASE_URL=https://lhpxqlmnifzmfeemfwmo.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_QZyshDVEXpHiMz2VvO71Bg_Wdr7HG0E

# ── Social OAuth providers (Google + Facebook) ────────────────────────────────
# Both providers are driven by supabase.auth.signInWithOAuth() from
# src/components/AuthFlow.tsx, so there are NO client id/secret values in this
# file. The credentials live in the Supabase dashboard:
#   Supabase → Authentication → Providers → Google / Facebook
#
# Google:
#   Client ID / Client Secret come from Google Cloud Console → Credentials.
#   Authorised redirect URI MUST be:
#     https://<project-ref>.supabase.co/auth/v1/callback
#
# Facebook:
#   App ID / App Secret come from developers.facebook.com → your App → Settings.
#   Valid OAuth Redirect URIs MUST include the same Supabase callback above.
#   The app requests the `email` + `public_profile` scopes; Facebook only
#   returns an email if the app has passed App Review or the account has a
#   verified email, otherwise the callback lands with a null email.
#
# Also add this app's own URLs under Supabase → Authentication → URL
# Configuration → Redirect URLs (the value returned by buildOAuthRedirectUrl()):
#   https://zidbdsaas.com
#   https://*.zidbdsaas.com
#   http://localhost:5173
GOOGLE_OAUTH_ENABLED=true
FACEBOOK_OAUTH_ENABLED=true

# SMTP settings for real email delivery via NodeMailer
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ── Super Admin Gateway ───────────────────────────────────────────────────────
# SUPER_ADMIN_PIN (REQUIRED to open the Super Admin portal in production):
# verified SERVER-SIDE by POST /api/admin/verify-pin (lib/serverApp.ts), so the
# PIN never ships in the browser bundle and rotating it needs no rebuild.
#
# Setup (local development):
#   1. Copy this file to .env.local (or create .env.local in the project root —
#      it is git-ignored, never commit real values)
#   2. Add:  SUPER_ADMIN_PIN=choose-a-strong-pin
#   3. Restart the dev server (`npm run dev`) / redeploy
#
# If unset, the gateway FAILS CLOSED but never crashes: the UI shows the exact
# setup instructions above instead of a generic error.
#
# DEMO VALUE: the local/dev default below is 3565 (the classic Zid demo PIN).
# This file is PUBLIC — change the PIN before any real deployment.
SUPER_ADMIN_PIN=3565

# Optional fallback master key — consulted only when SUPER_ADMIN_PIN is unset.
ADMIN_MASTER_KEY=3565

# LEGACY client-bundled passcode. Honoured ONLY as a fallback when the server
# has neither SUPER_ADMIN_PIN nor ADMIN_MASTER_KEY configured (or the verify
# API is unreachable). Prefer SUPER_ADMIN_PIN: a VITE_ variable is compiled
# into the JS bundle and visible to anyone with DevTools.
VITE_SUPER_ADMIN_PASSCODE=3565

# ── Dual-channel OTP delivery ────────────────────────────────────────────────
# WhatsApp is the PRIMARY channel for verification codes; email is the automatic
# fallback when WhatsApp is unconfigured, fails, or times out. Configure at
# least one provider below, otherwise no code can be delivered in production.

# WhatsApp provider (any ONE of these groups is enough). Providers are tried in
# the order: UltraMsg -> Twilio -> Meta Cloud API -> GreenAPI.
ULTRAMSG_INSTANCE_ID=
ULTRAMSG_TOKEN=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=
WHATSAPP_CLOUD_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
GREENAPI_INSTANCE_ID=
GREENAPI_API_TOKEN=

# Email fallback provider (Resend preferred; SMTP used when Resend is unset).
RESEND_API_KEY=
RESEND_FROM=

# MongoDB and JWT Auth credentials
MONGODB_URI=
JWT_SECRET=

# ── Storefront host routing ────────────────────────────────────────────────────
# The root domain merchant subdomains hang off. `middleware.ts` rewrites
# `<slug>.<root>` to `/store/<slug>`, and `src/App.tsx` uses the same value as a
# client-side fallback when middleware is not deployed.
#
# MUST be the domain whose WILDCARD DNS record points at this deployment, e.g.
# `*.zidbdsaas.com -> cname.vercel-dns.com`, or subdomains will not resolve.
STOREFRONT_ROOT_DOMAIN=zidbdsaas.com
# Same value, exposed to the browser bundle (the client fallback reads VITE_*).
VITE_STOREFRONT_ROOT_DOMAIN=zidbdsaas.com

# Absolute base URL used to build payment-gateway callback URLs (success/fail/
# cancel/IPN). Leave blank to derive it from the incoming request's host, which
# works on previews and custom domains. Set it when a proxy does not forward the
# original host header.
PUBLIC_APP_URL=

# Custom-domain DNS targets shown to merchants in Settings → Domains.
CUSTOM_DOMAIN_A_TARGET=76.76.21.21
CUSTOM_DOMAIN_CNAME_TARGET=cname.zidbdsaas.com

# ── SMS gateways (Bangladesh) ──────────────────────────────────────────────────
# Dispatched by lib/smsService.ts for order confirmation, shipping and delivery
# updates. A merchant can save their OWN key per store (Settings → Integrations);
# these platform-level keys are the fallback so SMS can be enabled centrally.
# Providers: greenweb | sslwireless | bulksmsbd | alpha
SMS_PROVIDER=
GREENWEB_API_KEY=
SSLWIRELESS_API_KEY=
BULKSMSBD_API_KEY=
ALPHA_SMS_API_KEY=

# ── Live payment gateways (Bangladesh) ─────────────────────────────────────────
# Used by lib/paymentGateway.ts to charge cards / MFS through SSLCommerz or
# Shurjopay. A merchant can also save their own credentials per store
# (Settings → Payments); these are the platform-level fallbacks.
#
# IMPORTANT: SANDBOX defaults to TRUE. Set these to "false" ONLY when you have
# live (production) credentials — otherwise real customer cards are never charged
# and every payment stays in the test environment.
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_MERCHANT_PREFIX=
SSLCOMMERZ_SANDBOX=true

SHURJOPAY_USERNAME=
SHURJOPAY_PASSWORD=
SHURJOPAY_PREFIX=
SHURJOPAY_SANDBOX=true
